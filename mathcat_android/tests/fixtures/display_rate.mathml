<math xmlns="http://www.w3.org/1998/Math/MathML" display="block" id="vox-math-60"><semantics><mrow><mfrac><mrow><mo stretchy="true" form="prefix">|</mo><msub><mi>u</mi><mi>r</mi></msub><mo stretchy="true" form="postfix">|</mo></mrow><msub><mo>ℓ</mo><mi>r</mi></msub></mfrac><mo>=</mo><mi>O</mi><mrow><mo stretchy="true" form="prefix">(</mo><msup><mi>τ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="true" form="postfix">)</mo></mrow><mo>,</mo><mspace width="2.0em"/><mfrac><mrow><mo stretchy="true" form="prefix">|</mo><msub><mi>u</mi><mi>z</mi></msub><mo stretchy="true" form="postfix">|</mo></mrow><msub><mo>ℓ</mo><mi>z</mi></msub></mfrac><mo>≍</mo><msup><mi>τ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mspace width="2.0em"/><mfrac><mi>ν</mi><msubsup><mo>ℓ</mo><mi>r</mi><mn>2</mn></msubsup></mfrac><mo>≍</mo><msup><mi>τ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>.</mi></mrow><annotation encoding="application/x-tex">\frac{|u_r|}{\ell_r} = O(\tau^{-1}), \qquad \frac{|u_z|}{\ell_z} \asymp \tau^{-1}, \qquad \frac{\nu}{\ell_r^2} \asymp \tau^{-1}.</annotation></semantics></math>
