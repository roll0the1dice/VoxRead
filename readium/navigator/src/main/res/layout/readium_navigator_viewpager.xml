<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraint"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Shares the reader's viewport for background pagination, behind the visible pager. -->
    <FrameLayout
        android:id="@+id/pagination_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/pagination_container_secondary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/pagination_container_3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/pagination_container_4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/pagination_container_5"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/pagination_container_6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/pagination_container_7"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/pagination_container_8"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <org.readium.r2.navigator.pager.R2ViewPager
        android:id="@+id/resourcePager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
